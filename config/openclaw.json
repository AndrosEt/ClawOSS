{
  "agents": {
    "defaults": {
      "compaction": {
        "mode": "safeguard",
        "reserveTokens": 30000,
        "keepRecentTokens": 20000,
        "maxHistoryShare": 0.6,
        "recentTurnsPreserve": 3,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 150000
        },
        "postCompactionSections": [
          "Orchestrator + Sub-Agent Architecture",
          "Safety Defaults",
          "Context Rot Prevention"
        ]
      },
      "model": {
        "primary": "kimi-coding/k2p5",
        "fallbacks": []
      },
      "subagents": {
        "model": "kimi-coding/k2p5",
        "maxConcurrent": 5
      }
    },
    "list": [
      {
        "id": "clawoss",
        "default": true,
        "name": "ClawOSS",
        "workspace": "__WORKSPACE_PATH__",
        "model": "kimi-coding/k2p5",
        "tools": {
          "profile": "coding"
        },
        "humanDelay": {
          "mode": "off"
        },
        "heartbeat": {
          "every": "10m",
          "model": "kimi-coding/k2p5",
          "session": "main",
          "target": "none",
          "prompt": "You are autonomous. Read HEARTBEAT.md and execute EVERY step 0-7. Do NOT just reply HEARTBEAT_OK. You MUST: check work queue, pick a task, spawn a sub-agent, and self-wake after completion. HEARTBEAT_OK is ONLY valid when there is literally zero work available. If work exists, DO IT.",
          "lightContext": true
        }
      }
    ]
  },
  "gateway": {
    "port": 18789,
    "mode": "local"
  },
  "messages": {
    "queue": {
      "mode": "collect",
      "debounceMs": 500,
      "cap": 10
    }
  },
  "tools": {
    "sessions_spawn": {
      "attachments": {
        "enabled": true
      }
    },
    "web": {
      "search": {
        "enabled": true,
        "provider": "perplexity"
      },
      "fetch": {
        "enabled": true
      }
    },
    "exec": {
      "applyPatch": {
        "enabled": true
      }
    },
    "loopDetection": {
      "enabled": true
    }
  },
  "skills": {
    "load": {
      "watch": true
    }
  },
  "logging": {
    "level": "info"
  }
}
