{
  "agents": {
    "defaults": {
      "compaction": {
        "mode": "safeguard",
        "reserveTokens": 30000,
        "keepRecentTokens": 20000,
        "maxHistoryShare": 0.6,
        "recentTurnsPreserve": 3,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 150000
        },
        "postCompactionSections": [
          "Orchestrator + Sub-Agent Architecture",
          "Safety Defaults",
          "Context Rot Prevention"
        ]
      },
      "model": {
        "primary": "openrouter/moonshotai/kimi-k2.5",
        "fallbacks": []
      },
      "subagents": {
        "model": "openrouter/moonshotai/kimi-k2.5",
        "maxConcurrent": 1,
        "runTimeoutSeconds": 600
      }
    },
    "list": [
      {
        "id": "clawoss",
        "default": true,
        "name": "ClawOSS",
        "workspace": "/Users/kevinlin/clawOSS/workspace",
        "model": "openrouter/moonshotai/kimi-k2.5",
        "tools": {
          "profile": "coding"
        },
        "humanDelay": {
          "mode": "off"
        },
        "heartbeat": {
          "every": "10m",
          "model": "openrouter/moonshotai/kimi-k2.5",
          "session": "main",
          "target": "none",
          "prompt": "Read HEARTBEAT.md. Follow it strictly. Do not infer old tasks. If nothing needs attention, reply HEARTBEAT_OK.",
          "lightContext": true
        }
      }
    ]
  },
  "gateway": {
    "port": 18789,
    "mode": "local"
  },
  "messages": {
    "queue": {
      "mode": "collect",
      "debounceMs": 500,
      "cap": 10
    }
  },
  "tools": {
    "sessions_spawn": {
      "attachments": {
        "enabled": true
      }
    }
  },
  "skills": {
    "load": {
      "watch": true
    }
  },
  "logging": {
    "level": "info"
  }
}
