# ClawOSS Environment — copy to .env and fill in ALL required values
# DO NOT COMMIT .env — it is gitignored

# ============================================================
# === REQUIRED: GitHub Account
# ============================================================

# GitHub Personal Access Token — needs public_repo scope
GITHUB_TOKEN=ghp_your-token-here

# Your GitHub username (used for PRs, fork cloning, PR search)
GITHUB_USERNAME=your-github-username

# Git commit email
GITHUB_EMAIL=you@users.noreply.github.com

# ============================================================
# === REQUIRED: LLM Model (any OpenAI-compatible API)
# ============================================================

# Model in {provider}/{model_id} format
# Examples:
#   openai/gpt-4o           → LLM_BASE_URL=https://api.openai.com/v1
#   anthropic/claude-opus-4 → LLM_BASE_URL=https://api.anthropic.com/v1 (via proxy)
#   deepseek/deepseek-chat  → LLM_BASE_URL=https://api.deepseek.com
#   qwen/qwen-max           → LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=openai/gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here

# Provider identifier for telemetry (e.g. openai, anthropic, deepseek, minimax, kimi-code)
LLM_PROVIDER=openai

# Context window and max output tokens (adjust for your model)
LLM_CONTEXT_WINDOW=128000
LLM_MAX_TOKENS=16384

# Cost tracking (USD per million tokens — for Dashboard cost display)
LLM_INPUT_COST_PER_MILLION=2.50
LLM_OUTPUT_COST_PER_MILLION=10.00

# Optional: Fallback model (same format as above)
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# ============================================================
# === OPTIONAL: Budget Control
# ============================================================

# Total spending limit in USD (0 = unlimited)
# When total spend reaches this limit, the agent stops spawning new work
TOKEN_BUDGET_USD=50

# ============================================================
# === OPTIONAL: Dashboard
# ============================================================

# Vercel Dashboard URL
DASHBOARD_URL=https://clawoss-dashboard.vercel.app

# Shared secret for Dashboard ingest API authentication
CLAW_API_KEY=your-shared-secret-here

# ============================================================
# === AUTO-DETECTED: Project paths (do not change)
# ============================================================
CLAWOSS_DIR=your-project-directory
